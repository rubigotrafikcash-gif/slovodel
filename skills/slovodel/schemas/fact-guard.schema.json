{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubigotrafikcash-gif/slovodel/blob/main/schemas/fact-guard.schema.json",
  "title": "Slovodel protected facts A8 report v2",
  "description": "Rules 2.4: heuristic findings and comparison normalization, never semantic equivalence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guard_version",
    "tool_version",
    "decision",
    "publish_ready",
    "semantic_equivalence",
    "changed",
    "findings",
    "warnings",
    "source_sha256",
    "revision_sha256",
    "protected_terms_count",
    "comparison_normalization"
  ],
  "properties": {
    "guard_version": {
      "const": "a8-rules-2.4"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "unchanged",
        "review_required",
        "blocked"
      ]
    },
    "publish_ready": {
      "const": false
    },
    "semantic_equivalence": {
      "const": "not_verified"
    },
    "changed": {
      "type": "boolean"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protected_terms_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "severity",
          "before_count",
          "after_count",
          "removed_count",
          "added_count"
        ],
        "properties": {
          "kind": {
            "enum": [
              "url",
              "email",
              "money",
              "date",
              "deadline",
              "calendar",
              "range",
              "quantity",
              "code",
              "number",
              "number_word",
              "binding",
              "organization",
              "person",
              "proper_name",
              "polarity",
              "modality",
              "guarantee",
              "protected_term",
              "condition",
              "quantifier",
              "commercial_term",
              "initial_capital",
              "audience_context",
              "temporal_context",
              "epistemic_context",
              "attribution"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "review"
            ]
          },
          "before_count": {
            "type": "integer",
            "minimum": 0
          },
          "after_count": {
            "type": "integer",
            "minimum": 0
          },
          "removed_count": {
            "type": "integer",
            "minimum": 0
          },
          "added_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "comparison_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "kind"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "mixed_script_visual",
                  "mixed_avito_alias"
                ]
              }
            }
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "kind"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "mixed_script_visual",
                  "mixed_avito_alias"
                ]
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "blocked"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "blocker"
                }
              },
              "required": [
                "severity"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "review_required"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "changed": {
            "const": true
          },
          "findings": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "severity": {
                    "const": "blocker"
                  }
                },
                "required": [
                  "severity"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "unchanged"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "changed": {
            "const": false
          },
          "findings": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}

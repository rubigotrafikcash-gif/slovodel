{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubigotrafikcash-gif/slovodel/blob/main/schemas/local-reference.schema.json",
  "title": "Self-declared non-normative local Russian letter reference profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_label",
    "source_url",
    "genre",
    "corpus_version",
    "license_id",
    "rights_basis",
    "format",
    "profile_kind",
    "license_status",
    "source_sha256",
    "method_version",
    "preprocessing",
    "total_letters",
    "counts"
  ],
  "properties": {
    "source_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "source_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "genre": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "corpus_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "license_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "rights_basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "format": {
      "const": "slovodel.local-letter-reference.v1"
    },
    "profile_kind": {
      "const": "user_supplied_non_normative"
    },
    "license_status": {
      "const": "self_declared_unverified"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "method_version": {
      "type": "string",
      "minLength": 1
    },
    "preprocessing": {
      "const": "NFC+exclude_URL_email+casefold+count_RU33"
    },
    "total_letters": {
      "type": "integer",
      "minimum": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "а",
        "б",
        "в",
        "г",
        "д",
        "е",
        "ё",
        "ж",
        "з",
        "и",

        "ц",
        "ч",
        "ш",
        "щ",
        "ъ",
        "ы",
        "ь",
        "э",
        "ю",
        "я"
      ],
      "properties": {
        "а": {
          "type": "integer",
          "minimum": 0
        },
        "б": {
